<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Полный путь неврологического пациента — конференция 27–29 ноября, Краснодар</title>
<meta name="description" content="Практическая конференция для ветеринарных врачей. Неврология, хирургия, ОРИТ. 27–29 ноября, Краснодар.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800;900&family=Unbounded:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --c0:#050d1a; --c1:#071224; --c2:#0a1a32; --c3:#0e2346;
  --blue:#1a4fa8; --blue2:#2463c8; --cyan:#00b4e6; --cyan2:#40d4ff;
  --gold:#f0a500; --gold2:#ffc840;
  --w:#fff; --w7:rgba(255,255,255,.7); --w4:rgba(255,255,255,.4); --w15:rgba(255,255,255,.15); --w08:rgba(255,255,255,.08);
  --r:18px; --rs:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Onest',sans-serif;background:var(--c0);color:var(--w);overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:1200px;margin:0 auto;padding:0 2rem}
@media(max-width:640px){.wrap{padding:0 1rem}}

/* ══ LOADER ══════════════════════════════════════════ */
#ldr{position:fixed;inset:0;z-index:9999;background:var(--c0);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;transition:opacity .7s ease,visibility .7s ease}
#ldr.out{opacity:0;visibility:hidden;pointer-events:none}
.ldr-scene{position:relative;width:120px;height:120px}
.ldr-ring{position:absolute;border-radius:50%;border:2px solid transparent}
.ldr-r1{inset:0;border-top-color:var(--cyan);border-right-color:var(--cyan2);animation:rSpin 1.4s linear infinite}
.ldr-r2{inset:12px;border-top-color:var(--gold);border-left-color:var(--gold2);animation:rSpin 2s linear infinite reverse}
.ldr-r3{inset:24px;border-bottom-color:var(--blue2);animation:rSpin 2.8s linear infinite}
.ldr-core{position:absolute;inset:38px;border-radius:50%;background:radial-gradient(circle at 35% 35%,var(--cyan2),var(--blue) 60%,var(--c0));box-shadow:0 0 30px var(--cyan),0 0 60px rgba(0,180,230,.3);animation:corePulse 2s ease-in-out infinite}
@keyframes rSpin{to{transform:rotate(360deg)}}
@keyframes corePulse{0%,100%{box-shadow:0 0 20px var(--cyan),0 0 40px rgba(0,180,230,.3)}50%{box-shadow:0 0 40px var(--cyan2),0 0 80px rgba(0,180,230,.5)}}
.ldr-txt{font-family:'Unbounded',sans-serif;font-size:13px;font-weight:800;letter-spacing:.08em;color:var(--w7);text-align:center}
.ldr-sub{font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--cyan);animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:.4}50%{opacity:1}}
.ldr-bar{width:200px;height:2px;background:var(--w08);border-radius:2px;overflow:hidden}
.ldr-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--gold));animation:fill 2s ease-out forwards;width:0}
@keyframes fill{to{width:100%}}

/* ══ HEADER ══════════════════════════════════════════ */
header{position:sticky;top:0;z-index:1000;background:rgba(5,13,26,.88);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid var(--w08)}
header::before{content:'';display:block;height:2px;background:linear-gradient(90deg,var(--blue) 0%,var(--cyan) 50%,var(--gold) 100%)}
.nav-in{max-width:1200px;margin:0 auto;padding:0 2rem;height:68px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand b{font-family:'Unbounded',sans-serif;font-size:13px;font-weight:900;color:var(--w);letter-spacing:-.01em}
.brand span{display:block;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan);margin-top:2px}
.qnav{display:flex;gap:4px;align-items:center}
.qnav a{color:var(--w7);font-size:13px;font-weight:600;padding:8px 12px;border-radius:8px;transition:.2s;white-space:nowrap}
.qnav a:hover{color:var(--w);background:var(--w08)}
.qnav .cta{background:linear-gradient(135deg,var(--blue),var(--cyan));color:var(--w)!important;padding:9px 18px;border-radius:10px;font-weight:700;box-shadow:0 4px 20px rgba(0,180,230,.3);transition:all .2s}
.qnav .cta:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,180,230,.5)}
.burger{display:none;flex-direction:column;gap:5px;width:40px;height:40px;align-items:center;justify-content:center;background:var(--w08);border:1px solid var(--w15);border-radius:10px;cursor:pointer;flex-shrink:0}
.burger span{width:18px;height:2px;background:var(--w);border-radius:2px;transition:.25s}
.burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(max-width:900px){
  .qnav a:not(.cta){display:none}
  .burger{display:flex}
}
/* sidebar nav */
@media(max-width:900px){
  .qnav{position:fixed;top:0;right:-280px;bottom:0;width:260px;background:var(--c1);flex-direction:column;align-items:stretch;gap:4px;padding:80px 1rem 24px;box-shadow:-8px 0 40px rgba(0,0,0,.5);transition:right .3s cubic-bezier(.4,0,.2,1);z-index:1100;max-height:none;border-left:1px solid var(--w08)}
  .qnav.open{right:0}
  .qnav a:not(.cta){display:block;padding:13px 14px;font-size:14px}
  .qnav .cta{margin-top:12px;text-align:center;justify-content:center;display:flex}
}
.nav-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(3px);z-index:1090}
.nav-overlay.open{display:block}

/* ══ HERO ════════════════════════════════════════════ */
.hero{position:relative;width:100%;overflow:hidden;background:var(--c0);min-height:100svh;display:flex;flex-direction:column}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center;opacity:.35;transform:scale(1.08);animation:imgReveal 14s ease-out forwards}
@keyframes imgReveal{to{transform:scale(1);opacity:.45}}
.hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(5,13,26,.97) 0%,rgba(10,26,50,.85) 40%,rgba(5,13,26,.6) 100%),linear-gradient(to top,rgba(5,13,26,1) 0%,transparent 50%)}
/* mesh gradient blobs */
.hero-blob{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;z-index:1}
.blob1{width:600px;height:600px;top:-100px;left:-100px;background:radial-gradient(circle,rgba(26,79,168,.4),transparent 70%);animation:blobDrift 8s ease-in-out infinite alternate}
.blob2{width:500px;height:500px;bottom:-80px;right:-80px;background:radial-gradient(circle,rgba(0,180,230,.25),transparent 70%);animation:blobDrift 10s ease-in-out infinite alternate reverse}
.blob3{width:300px;height:300px;top:40%;left:50%;background:radial-gradient(circle,rgba(240,165,0,.15),transparent 70%);animation:blobDrift 12s ease-in-out infinite alternate}
@keyframes blobDrift{0%{transform:translate(0,0) scale(1)}100%{transform:translate(30px,20px) scale(1.1)}}
/* particle dots */
.hero-particles{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.hero-content{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;justify-content:center;padding:120px 2rem 80px;max-width:820px;margin:0 auto;width:100%}
@media(max-width:640px){.hero-content{padding:90px 1rem 60px}}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(0,180,230,.12);border:1px solid rgba(0,180,230,.3);color:var(--cyan);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:7px 16px;border-radius:50px;margin-bottom:24px;animation:fadeUp .8s .2s both}
.hero-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan);animation:ping 1.5s ease-in-out infinite}
@keyframes ping{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
.hero-title{font-family:'Unbounded',sans-serif;font-size:clamp(28px,5vw,62px);font-weight:900;line-height:1.05;letter-spacing:-.03em;margin-bottom:20px;animation:fadeUp .8s .4s both}
.hero-title .line1{display:block;background:linear-gradient(135deg,var(--w) 0%,rgba(255,255,255,.8) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-title .line2{display:block;background:linear-gradient(135deg,var(--cyan) 0%,var(--cyan2) 50%,var(--gold2) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-date{display:inline-flex;align-items:center;gap:12px;background:var(--w08);border:1px solid var(--w15);color:var(--w);font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800;padding:12px 24px;border-radius:50px;margin-bottom:32px;animation:fadeUp .8s .6s both;backdrop-filter:blur(10px)}
.hero-lectors{display:flex;flex-direction:column;gap:10px;margin-bottom:36px;animation:fadeUp .8s .7s both}
.hero-lector{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid var(--w08);border-radius:12px;padding:12px 16px;transition:all .3s;cursor:default}
.hero-lector:hover{background:rgba(255,255,255,.08);border-color:var(--w15);transform:translateX(6px)}
.lector-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.lector-role{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--w4);min-width:100px;flex-shrink:0}
.lector-name{font-size:14px;font-weight:700;color:var(--w)}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;animation:fadeUp .8s .9s both}
@media(max-width:560px){.hero-btns{flex-direction:column}}

/* ══ BUTTONS ═════════════════════════════════════════ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:'Onest',sans-serif;font-size:15px;font-weight:700;padding:14px 28px;border-radius:12px;border:none;cursor:pointer;transition:all .25s;position:relative;overflow:hidden;text-decoration:none}
.btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.15),transparent 60%);opacity:0;transition:.2s}
.btn:hover::before{opacity:1}
.btn-primary{background:linear-gradient(135deg,var(--blue),var(--cyan));color:var(--w);box-shadow:0 6px 28px rgba(0,180,230,.35)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,180,230,.5)}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold2));color:var(--c0);box-shadow:0 6px 28px rgba(240,165,0,.35)}
.btn-gold:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(240,165,0,.5)}
.btn-ghost{background:var(--w08);color:var(--w);border:1.5px solid var(--w15);backdrop-filter:blur(10px)}
.btn-ghost:hover{background:var(--w15);transform:translateY(-2px)}

/* ══ STATS ═══════════════════════════════════════════ */
.stats{background:linear-gradient(135deg,var(--c1),var(--c2));border-top:1px solid var(--w08);border-bottom:1px solid var(--w08)}
.stats-inner{display:flex;justify-content:center;flex-wrap:wrap}
.stat-item{padding:24px 40px;text-align:center;border-right:1px solid var(--w08);flex:1 1 auto}
.stat-item:last-child{border-right:none}
.stat-num{font-family:'Unbounded',sans-serif;font-size:30px;font-weight:900;background:linear-gradient(135deg,var(--cyan),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
.stat-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--w4);margin-top:6px}
@media(max-width:600px){.stat-item{padding:16px 20px;min-width:50%}.stat-num{font-size:22px}}

/* ══ SECTIONS ════════════════════════════════════════ */
section{padding:80px 0}
@media(max-width:640px){section{padding:50px 0}}
.sec-kicker{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px;display:block}
.sec-title{font-family:'Unbounded',sans-serif;font-size:clamp(22px,3.5vw,38px);font-weight:900;letter-spacing:-.03em;line-height:1.15;margin-bottom:14px}
.sec-title .accent{background:linear-gradient(135deg,var(--cyan),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sec-sub{font-size:16px;color:var(--w7);line-height:1.7;max-width:640px}
.sec-head{margin-bottom:3rem}

/* ══ ABOUT CARDS ═════════════════════════════════════ */
.about-section{background:var(--c0)}
.about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:860px){.about-grid{grid-template-columns:1fr}}
.acard{background:linear-gradient(135deg,rgba(255,255,255,.04),rgba(255,255,255,.02));border:1px solid var(--w08);border-radius:var(--r);padding:2rem;transition:all .35s;position:relative;overflow:hidden}
.acard::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--gold));transform:scaleX(0);transform-origin:left;transition:.35s}
.acard:hover{transform:translateY(-8px);border-color:var(--w15);background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.03));box-shadow:0 20px 60px rgba(0,0,0,.4)}
.acard:hover::before{transform:scaleX(1)}
.acard-icon{font-size:40px;margin-bottom:1rem;display:block;filter:drop-shadow(0 4px 8px rgba(0,180,230,.3))}
.acard h3{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:800;color:var(--w);margin-bottom:.6rem;letter-spacing:-.02em}
.acard p{font-size:14px;color:var(--w7);line-height:1.7}

/* ══ SPEAKERS ════════════════════════════════════════ */
.speakers-section{background:linear-gradient(180deg,var(--c1) 0%,var(--c2) 100%);position:relative;overflow:hidden}
.speakers-section::before{content:'';position:absolute;top:-200px;left:50%;transform:translateX(-50%);width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(26,79,168,.15),transparent 70%);pointer-events:none}
.speakers-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:860px){.speakers-grid{grid-template-columns:1fr}}
.spk-card{background:rgba(255,255,255,.03);border:1px solid var(--w08);border-radius:var(--r);overflow:hidden;transition:all .3s;transform-style:preserve-3d;will-change:transform}
.spk-card:hover{border-color:var(--w15);box-shadow:0 24px 80px rgba(0,0,0,.5)}
.spk-card.main{border-color:rgba(0,180,230,.3);background:rgba(0,180,230,.05)}
.spk-photo{width:100%;aspect-ratio:1/1;overflow:hidden;position:relative;background:var(--c3)}
.spk-photo img{width:100%;height:100%;object-fit:cover;object-position:center 20%;transition:transform .6s ease;filter:grayscale(20%)}
.spk-card:hover .spk-photo img{transform:scale(1.06)}
.spk-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(5,13,26,.9) 0%,transparent 50%)}
.spk-body{padding:1.4rem}
.spk-role{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);margin-bottom:6px}
.spk-name{font-family:'Unbounded',sans-serif;font-size:16px;font-weight:900;color:var(--w);margin-bottom:.6rem;letter-spacing:-.02em}
.spk-desc{font-size:13.5px;color:var(--w7);line-height:1.65}

/* ══ PROGRAM ═════════════════════════════════════════ */
.program-section{background:var(--c0)}
.prog-grid{display:flex;flex-direction:column;gap:3px}
.prog-item{display:grid;grid-template-columns:120px 1fr;gap:0;background:rgba(255,255,255,.03);border:1px solid var(--w08);border-radius:10px;overflow:hidden;transition:all .3s}
.prog-item:hover{background:rgba(255,255,255,.06);border-color:var(--w15);transform:translateX(4px)}
.prog-item.break{opacity:.5}
.prog-item.break:hover{transform:none}
.prog-time{padding:16px 14px;background:rgba(0,180,230,.07);border-right:1px solid var(--w08);font-size:12px;font-weight:800;color:var(--cyan);display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Unbounded',sans-serif;letter-spacing:-.01em}
.prog-body{padding:16px 20px}
.prog-speaker{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan);margin-bottom:4px}
.prog-title{font-size:14px;font-weight:700;color:var(--w);margin-bottom:4px}
.prog-desc{font-size:13px;color:var(--w7);line-height:1.55}
@media(max-width:560px){.prog-item{grid-template-columns:90px 1fr}.prog-time{font-size:10px;padding:12px 8px}}

/* ══ REGISTER ════════════════════════════════════════ */
.reg-section{background:linear-gradient(135deg,var(--c2),var(--c3))}
.reg-inner{max-width:680px;margin:0 auto;text-align:center}
.reg-inner h2{font-family:'Unbounded',sans-serif;font-size:clamp(22px,4vw,38px);font-weight:900;letter-spacing:-.03em;margin-bottom:16px}
.reg-inner h2 .g{background:linear-gradient(135deg,var(--cyan),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.reg-inner p{color:var(--w7);font-size:16px;line-height:1.7;margin-bottom:32px}
.reg-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:32px}
@media(max-width:480px){.reg-btns{flex-direction:column;align-items:center}.reg-btns .btn{width:100%;max-width:320px}}
.reg-contacts{display:flex;flex-direction:column;gap:10px;max-width:380px;margin:0 auto}
.reg-link{display:flex;align-items:center;gap:12px;background:var(--w08);border:1px solid var(--w15);border-radius:12px;padding:13px 18px;color:var(--w);font-weight:600;font-size:14px;transition:all .2s}
.reg-link:hover{background:var(--w15);transform:translateX(4px)}
.reg-link svg{width:18px;height:18px;color:var(--cyan);flex-shrink:0}

/* ══ SIDEBAR / PROMO ═════════════════════════════════ */
.info-section{background:var(--c1)}
.info-grid{display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start}
@media(max-width:900px){.info-grid{grid-template-columns:1fr}}
.icard{background:rgba(255,255,255,.03);border:1px solid var(--w08);border-radius:var(--r);padding:1.6rem;margin-bottom:16px}
.icard h3{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:800;color:var(--w);margin-bottom:1rem;letter-spacing:-.01em}
.irow{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;font-size:14px}
.irow:last-child{margin-bottom:0}
.irow-ico{font-size:18px;flex-shrink:0;margin-top:1px}
.irow strong{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--w4);margin-bottom:2px}
.irow span{color:var(--w7);line-height:1.5}
.promo-badge{display:inline-block;background:linear-gradient(135deg,var(--gold),var(--gold2));color:var(--c0);font-family:'Unbounded',sans-serif;font-size:20px;font-weight:900;padding:8px 16px;border-radius:10px;margin-bottom:12px}

/* ══ MODAL ═══════════════════════════════════════════ */
.modal-overlay{position:fixed;inset:0;background:rgba(5,13,26,.8);backdrop-filter:blur(12px);z-index:2000;display:none;align-items:flex-start;justify-content:center;overflow-y:auto;padding:2rem 1rem}
.modal-overlay.open{display:flex}
.modal{background:var(--c1);border:1px solid var(--w15);border-radius:24px;padding:2.5rem 2rem 2rem;width:100%;max-width:500px;position:relative;animation:mUp .35s cubic-bezier(.34,1.56,.64,1);margin:auto}
@media(max-width:520px){.modal{border-radius:20px 20px 0 0;margin:auto 0 0 0;padding:1.4rem 1.2rem 2rem;border-bottom-left-radius:0;border-bottom-right-radius:0}}
.modal-close{position:absolute;top:1.2rem;right:1.2rem;background:var(--w08);border:1px solid var(--w15);border-radius:50%;width:40px;height:40px;cursor:pointer;font-size:18px;color:var(--w);display:flex;align-items:center;justify-content:center;transition:.2s}
.modal-close:hover{background:var(--w15)}
@keyframes mUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-eye{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);margin-bottom:8px}
.modal h2{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:900;color:var(--w);margin-bottom:.4rem;letter-spacing:-.02em}
.modal-sub{font-size:14px;color:var(--w7);margin-bottom:1.6rem;line-height:1.6}
.fg{margin-bottom:1.1rem}
.fg label{display:block;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--w4);margin-bottom:6px}
.fg input,.fg textarea{width:100%;padding:13px 16px;border:1.5px solid var(--w15);border-radius:10px;font-family:'Onest',sans-serif;font-size:15px;color:var(--w);background:rgba(255,255,255,.05);transition:.2s;-webkit-appearance:none}
.fg input::placeholder,.fg textarea::placeholder{color:var(--w4)}
.fg input:focus,.fg textarea:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,180,230,.15)}
.fg textarea{height:80px;resize:vertical}
.consent-wrap{border:1.5px solid var(--w15);border-radius:10px;padding:13px 16px;background:rgba(255,255,255,.03);cursor:pointer;margin-bottom:1.2rem;transition:.2s}
.consent-wrap:hover{border-color:var(--w15);background:rgba(255,255,255,.06)}
.consent-row{display:flex;align-items:flex-start;gap:12px}
.consent-box{width:22px;height:22px;min-width:22px;border:2px solid var(--w15);border-radius:6px;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;transition:.2s;flex-shrink:0;margin-top:1px}
.consent-box.on{background:var(--cyan);border-color:var(--cyan)}
.consent-box svg{display:none}
.consent-box.on svg{display:block}
.consent-text{font-size:13px;color:var(--w7);line-height:1.6;user-select:none}
.consent-err{display:none;color:#ff6b6b;font-size:12px;font-weight:600;margin-top:8px;margin-left:34px}
.consent-err.show{display:block}
.form-success{text-align:center;padding:1rem 0}
.form-success h3{font-family:'Unbounded',sans-serif;font-size:18px;color:var(--cyan);margin:1rem 0 .4rem;font-weight:900}
.form-success p{color:var(--w7);font-size:14px;line-height:1.7;margin-bottom:1.5rem}
.form-success .send-btns{display:flex;flex-direction:column;gap:10px}

/* ══ TOAST ═══════════════════════════════════════════ */
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(16px);background:var(--c2);border:1px solid var(--w15);color:var(--w);padding:12px 22px;border-radius:50px;font-size:14px;font-weight:600;box-shadow:0 8px 40px rgba(0,0,0,.5);z-index:3000;opacity:0;pointer-events:none;transition:.3s;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ══ FOOTER ══════════════════════════════════════════ */
footer{background:var(--c0);border-top:1px solid var(--w08);padding:40px 0}
.foot-in{max-width:1200px;margin:0 auto;padding:0 2rem;text-align:center}
.foot-brand{font-family:'Unbounded',sans-serif;font-size:14px;font-weight:900;color:var(--w);margin-bottom:8px}
.foot-in p{font-size:13px;color:var(--w4);line-height:1.7}
.foot-bottom{max-width:1200px;margin:20px auto 0;padding:20px 2rem 0;border-top:1px solid var(--w08);text-align:center;font-size:12px;color:var(--w4)}
.top-btn{position:fixed;right:20px;bottom:20px;width:46px;height:46px;background:linear-gradient(135deg,var(--blue),var(--cyan));border:none;border-radius:12px;color:var(--w);font-size:20px;font-weight:900;cursor:pointer;z-index:50;transition:.2s;box-shadow:0 6px 24px rgba(0,180,230,.3);opacity:0;pointer-events:none}
.top-btn.vis{opacity:1;pointer-events:auto}
.top-btn:hover{transform:translateY(-3px)}

/* ══ SHARE ═══════════════════════════════════════════ */
.share-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:.8rem}
.sh-btn{padding:9px 16px;border:1px solid var(--w15);border-radius:8px;background:var(--w08);color:var(--w);font-size:12px;font-weight:700;cursor:pointer;transition:.2s;font-family:'Onest',sans-serif}
.sh-btn:hover{background:var(--w15)}

/* ══ REVEAL ══════════════════════════════════════════ */
.rv{opacity:0;transform:translateY(28px);transition:opacity .7s cubic-bezier(.25,.8,.25,1),transform .7s cubic-bezier(.25,.8,.25,1)}
.rv.in{opacity:1;transform:translateY(0)}
.rv-l{opacity:0;transform:translateX(-28px);transition:opacity .7s cubic-bezier(.25,.8,.25,1),transform .7s cubic-bezier(.25,.8,.25,1)}
.rv-l.in{opacity:1;transform:translateX(0)}
[style*="--d"]{transition-delay:calc(var(--d)*80ms)}

@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

/* ══ MOBILE ≤480px ═══════════════════════════════════ */
@media(max-width:480px){
  /* nav */
  .nav-in{padding:0 .8rem;height:60px}
  .brand b{font-size:11px}
  .brand span{font-size:8px}

  /* hero */
  .hero{min-height:100svh}
  .hero-content{padding:80px .9rem 50px}
  .hero-badge{font-size:10px;padding:6px 12px;margin-bottom:18px}
  .hero-title{margin-bottom:14px}
  .hero-date{font-size:12px;padding:10px 16px;margin-bottom:22px}
  .hero-lector{padding:10px 12px;gap:10px}
  .lector-role{font-size:9px;min-width:90px}
  .lector-name{font-size:13px}
  .hero-btns{gap:8px}
  .btn{font-size:14px;padding:13px 18px;border-radius:10px}

  /* stats */
  .stat-item{min-width:50%;border-right:none;border-bottom:1px solid var(--w08)}
  .stat-item:nth-child(odd){border-right:1px solid var(--w08)}
  .stats-inner{display:grid;grid-template-columns:1fr 1fr}
  .stat-num{font-size:20px}
  .stat-label{font-size:10px}

  /* sections */
  section{padding:40px 0}
  .sec-title{font-size:20px}
  .sec-sub{font-size:14px}
  .sec-head{margin-bottom:1.6rem}

  /* about cards */
  .acard{padding:1.4rem}
  .acard-icon{font-size:32px;margin-bottom:.7rem}
  .acard h3{font-size:14px}
  .acard p{font-size:13px}

  /* speakers */
  .spk-name{font-size:14px}
  .spk-body{padding:1rem}
  .spk-desc{font-size:13px}
  .spk-photo{aspect-ratio:1/1}

  /* program */
  .prog-item{grid-template-columns:72px 1fr}
  .prog-time{font-size:9px;padding:10px 6px;letter-spacing:-.02em}
  .prog-body{padding:12px 14px}
  .prog-title{font-size:13px}
  .prog-desc{font-size:12px}
  .prog-speaker{font-size:9px}

  /* info cards */
  .icard{padding:1.2rem}
  .icard h3{font-size:13px}
  .irow{font-size:13px}
  .reg-link{font-size:13px;padding:11px 14px}
  .promo-badge{font-size:17px}

  /* modal */
  .modal{padding:1.2rem 1rem 1.6rem}
  .modal h2{font-size:17px}
  .modal-sub{font-size:13px}
  .fg input,.fg textarea{font-size:14px;padding:12px 13px}

  /* footer */
  .foot-in{padding:0 1rem}
  .foot-brand{font-size:12px}
  .foot-in p{font-size:12px}

  /* top btn */
  .top-btn{right:12px;bottom:12px;width:40px;height:40px;font-size:16px;border-radius:10px}

  /* share */
  .share-row{flex-wrap:wrap}
  .sh-btn{font-size:11px;padding:8px 12px}
}

/* ══ SAFE AREA (notch/home indicator) ════════════════ */
@supports(padding:max(0px)){
  .hero-content{padding-top:max(80px, calc(60px + env(safe-area-inset-top)))}
  .modal{padding-bottom:max(2rem, calc(1rem + env(safe-area-inset-bottom)))}
  footer{padding-bottom:max(40px, calc(20px + env(safe-area-inset-bottom)))}
}
</style>
</head>
<body>

<!-- LOADER -->
<div id="ldr">
  <div class="ldr-scene">
    <div class="ldr-ring ldr-r1"></div>
    <div class="ldr-ring ldr-r2"></div>
    <div class="ldr-ring ldr-r3"></div>
    <div class="ldr-core"></div>
  </div>
  <div class="ldr-txt">Полный путь неврологического пациента</div>
  <div class="ldr-sub">Загружаем…</div>
  <div class="ldr-bar"><div class="ldr-fill"></div></div>
</div>

<header>
  <div class="nav-in">
    <a class="brand" href="#top">
      <b>Конференция для ветврачей</b>
      <span>27–29 ноября · Краснодар</span>
    </a>
    <nav class="qnav" id="qnav">
      <a href="#about">О конференции</a>
      <a href="#speakers">Лекторы</a>
      <a href="#program">Программа</a>
      <a class="cta" href="tel:+79166574066">Позвонить</a>
    </nav>
    <button class="burger" id="burgerBtn" aria-label="Меню"><span></span><span></span><span></span></button>
  </div>
</header>

<main id="top">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img src="event-hero-operation.png" alt="Конференция — неврологический пациент">
    </div>
    <div class="hero-blob blob1"></div>
    <div class="hero-blob blob2"></div>
    <div class="hero-blob blob3"></div>
    <canvas class="hero-particles" id="particles"></canvas>
    <div class="hero-content">
      <div class="hero-badge">✦ Открыта регистрация</div>
      <h1 class="hero-title">
        <span class="line1">Полный путь сложного</span>
        <span class="line2">неврологического пациента</span>
      </h1>
      <div class="hero-date">📅 27–29 ноября · Краснодар</div>
      <div class="hero-lectors">
        <div class="hero-lector">
          <div class="lector-dot" style="background:var(--cyan);box-shadow:0 0 8px var(--cyan)"></div>
          <span class="lector-role">Неврология</span>
          <span class="lector-name">Владимир Сотников</span>
        </div>
        <div class="hero-lector">
          <div class="lector-dot" style="background:var(--gold);box-shadow:0 0 8px var(--gold)"></div>
          <span class="lector-role">ОРИТ</span>
          <span class="lector-name">Валерия Митрофанова</span>
        </div>
        <div class="hero-lector">
          <div class="lector-dot" style="background:#a855f7;box-shadow:0 0 8px #a855f7"></div>
          <span class="lector-role">Юридические аспекты</span>
          <span class="lector-name">Виктория Кюллинен</span>
        </div>
      </div>
      <div class="hero-btns">
        <button class="btn btn-primary" onclick="openModal()">Записаться на конференцию →</button>
        <a class="btn btn-ghost" href="#program">Программа</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats">
    <div class="stats-inner">
      <div class="stat-item rv"><div class="stat-num">3</div><div class="stat-label">дня обучения</div></div>
      <div class="stat-item rv" style="--d:1"><div class="stat-num">3</div><div class="stat-label">ведущих эксперта</div></div>
      <div class="stat-item rv" style="--d:2"><div class="stat-num">8+</div><div class="stat-label">блоков программы</div></div>
      <div class="stat-item rv" style="--d:3"><div class="stat-num">100%</div><div class="stat-label">практические кейсы</div></div>
    </div>
  </div>

  <!-- ABOUT -->
  <section id="about" class="about-section">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="sec-kicker">О конференции</span>
        <h2 class="sec-title">Полный путь — <span class="accent">три дня</span></h2>
        <p class="sec-sub">Программа построена вокруг реального маршрута сложного неврологического пациента — от первых 15 минут приёма до выписки.</p>
      </div>
      <div class="about-grid">
        <div class="acard rv" style="--d:0">
          <span class="acard-icon">🧠</span>
          <h3>Неврология и нейрохирургия</h3>
          <p>Приём и сортировка экстренного пациента, невроосмотр, МРТ-диагностика, хирургическое решение и честные прогнозы по степеням дефицита.</p>
        </div>
        <div class="acard rv" style="--d:1">
          <span class="acard-icon">🏥</span>
          <h3>ОРИТ и интенсивная терапия</h3>
          <p>Шок без паники: типы шока, инфузионная тактика, вазопрессоры, мониторинг после CPR и профилактика вторичного повреждения мозга.</p>
        </div>
        <div class="acard rv" style="--d:2">
          <span class="acard-icon">⚖️</span>
          <h3>Юридическая защита врача</h3>
          <p>Как собирать доказательную базу: чеки, медзаписи, фото/видео, переписка — всё, что защитит вашу позицию при споре с владельцем.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SPEAKERS -->
  <section id="speakers" class="speakers-section">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="sec-kicker">Лекторы</span>
        <h2 class="sec-title">Три эксперта — <span class="accent">один путь</span></h2>
      </div>
      <div class="speakers-grid">
        <div class="spk-card rv" style="--d:0">
          <div class="spk-photo"><img src="speaker-mitrofanova.jpg" alt="Валерия Митрофанова" style="object-position:center 10%"></div>
          <div class="spk-body">
            <div class="spk-role">ОРИТ · Интенсивная терапия</div>
            <div class="spk-name">Валерия Митрофанова</div>
            <div class="spk-desc">Стабилизация, инфузионная терапия, послеоперационный мониторинг в ОРИТ и наблюдение после CPR у неврологических пациентов.</div>
          </div>
        </div>
        <div class="spk-card main rv" style="--d:1">
          <div class="spk-photo"><img src="speaker-sotnikov.jpg" alt="Владимир Сотников" style="object-position:center 5%"></div>
          <div class="spk-body">
            <div class="spk-role">Неврология · Нейрохирургия</div>
            <div class="spk-name">Владимир Сотников</div>
            <div class="spk-desc">Три ключевых сессии: приём экстренного пациента, невроосмотр и МРТ, хирургическое решение и прогноз. Разбор реальных клинических ошибок.</div>
          </div>
        </div>
        <div class="spk-card rv" style="--d:2">
          <div class="spk-photo"><img src="speaker-kyullinen.jpg" alt="Виктория Кюллинен" style="object-position:center 5%"></div>
          <div class="spk-body">
            <div class="spk-role">Юридические аспекты</div>
            <div class="spk-name">Виктория Кюллинен</div>
            <div class="spk-desc">Управление доказательной базой: чеки, медзаписи, фото/видео, переписка с клиентами как инструмент правовой защиты.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAM -->
  <section id="program" class="program-section">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="sec-kicker">Программа конференции</span>
        <h2 class="sec-title">Расписание <span class="accent">дня</span></h2>
      </div>
      <div class="prog-grid">
        <div class="prog-item rv"><div class="prog-time">10:00<br>10:10</div><div class="prog-body"><div class="prog-title">Открытие конференции</div><div class="prog-desc">Вступительное слово организаторов. Концепция «полный путь пациента».</div></div></div>
        <div class="prog-item rv"><div class="prog-time">10:10<br>11:25</div><div class="prog-body"><div class="prog-speaker">Кюллинен Виктория</div><div class="prog-title">Юридический блок — управление доказательной базой</div><div class="prog-desc">Чеки, медзаписи, фото/видео и переписка с клиентами. Защита позиции ветеринара. Q&A.</div></div></div>
        <div class="prog-item break rv"><div class="prog-time">11:25<br>11:40</div><div class="prog-body"><div class="prog-title">☕ Перерыв</div></div></div>
        <div class="prog-item rv"><div class="prog-time">11:40<br>12:30</div><div class="prog-body"><div class="prog-speaker">Сотников Владимир</div><div class="prog-title">Приём и сортировка — экстренный пациент в первые 15 минут</div><div class="prog-desc">Красный/жёлтый/зелёный пациент, триаж, кислород, венозный доступ. Пять обязательных параметров.</div></div></div>
        <div class="prog-item rv"><div class="prog-time">12:30<br>13:20</div><div class="prog-body"><div class="prog-speaker">Сотников Владимир</div><div class="prog-title">Невроосмотр и дифдиагностика — собака не ходит задними лапами</div><div class="prog-desc">IVDD, травма, FCE, опухоль, воспаление. Оценка глубокой боли, срочность МРТ, типичные ошибки.</div></div></div>
        <div class="prog-item break rv"><div class="prog-time">13:20<br>14:00</div><div class="prog-body"><div class="prog-title">🍽 Обеденный перерыв</div></div></div>
        <div class="prog-item rv"><div class="prog-time">14:00<br>14:45</div><div class="prog-body"><div class="prog-speaker">Митрофанова Валерия</div><div class="prog-title">Стабилизация и инфузионная терапия — шок без паники</div><div class="prog-desc">Четыре типа шока, лактат, болюсное введение, вазопрессоры, показания к гемотрансфузии.</div></div></div>
        <div class="prog-item rv"><div class="prog-time">14:45<br>15:35</div><div class="prog-body"><div class="prog-speaker">Сотников Владимир</div><div class="prog-title">Визуальная диагностика — МРТ позвоночника</div><div class="prog-desc">Компрессия, миелопатия, отёк, кровоизлияние. Ситуации, когда МРТ не объясняет клинику.</div></div></div>
        <div class="prog-item break rv"><div class="prog-time">15:35<br>15:50</div><div class="prog-body"><div class="prog-title">☕ Перерыв</div></div></div>
        <div class="prog-item rv"><div class="prog-time">15:50<br>16:40</div><div class="prog-body"><div class="prog-speaker">Сотников Владимир</div><div class="prog-title">Хирургическое решение и прогноз — болезнь диска: операция или нет?</div><div class="prog-desc">Алгоритмы по степеням неврологического дефицита. Честные прогнозы для каждого варианта.</div></div></div>
        <div class="prog-item rv"><div class="prog-time">16:40<br>17:25</div><div class="prog-body"><div class="prog-speaker">Митрофанова Валерия</div><div class="prog-title">ОРИТ — мониторинг после CPR у неврологических пациентов</div><div class="prog-desc">Восстановление сознания, гемодинамика, контроль судорог, профилактика вторичного повреждения мозга.</div></div></div>
        <div class="prog-item rv"><div class="prog-time">17:25<br>17:55</div><div class="prog-body"><div class="prog-speaker">Сотников Владимир</div><div class="prog-title">Разбор ошибок — 5 пациентов, которых нельзя было отпускать</div><div class="prog-desc">Реальные клинические случаи: сигналы, которые нельзя игнорировать.</div></div></div>
        <div class="prog-item rv"><div class="prog-time">17:55<br>18:00</div><div class="prog-body"><div class="prog-title">Закрытие конференции</div></div></div>
      </div>
    </div>
  </section>

  <!-- INFO + SIDEBAR -->
  <section class="info-section">
    <div class="wrap">
      <div class="info-grid">
        <div>
          <div class="icard rv">
            <h3>О мероприятии</h3>
            <div class="irow"><span class="irow-ico">📅</span><div><strong>Дата</strong><span>27–29 ноября 2026</span></div></div>
            <div class="irow"><span class="irow-ico">🕙</span><div><strong>Время</strong><span>10:00 – 18:00</span></div></div>
            <div class="irow"><span class="irow-ico">📍</span><div><strong>Место</strong><span>Краснодар — адрес высылаем при регистрации</span></div></div>
            <div class="irow"><span class="irow-ico">🎓</span><div><strong>Для кого</strong><span>Ветеринарные врачи: общая практика, терапевты, хирурги</span></div></div>
          </div>
          <div class="icard rv">
            <h3>Поделиться</h3>
            <div class="share-row">
              <button class="sh-btn" onclick="share('vk')">VK</button>
              <button class="sh-btn" onclick="share('tg')">Telegram</button>
              <button class="sh-btn" onclick="share('copy')">Копировать ссылку</button>
            </div>
          </div>
        </div>
        <div>
          <div class="icard rv">
            <div class="promo-badge">−20%</div>
            <h3>Скидка участникам</h3>
            <p style="color:var(--w7);font-size:14px;line-height:1.6;margin-bottom:1rem"><b>Гостиница «Хемингуэй»</b>, Краснодар, ул. Энергетиков, 5 — скидка 20% для участников конференции.</p>
            <a class="reg-link" href="tel:+78005002054">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15.5c0 1-.8 2.5-2 2.5C11.5 18 6 12.5 6 5c0-1.2 1.5-2 2.5-2 .4 0 .8.3 1 .7l1.5 3c.2.5.1 1-.3 1.3L9 9.3c.9 2 2.7 3.8 4.7 4.7l1.3-1.7c.3-.4.8-.5 1.3-.3l3 1.5c.4.2.7.6.7 1z"/></svg>
              8 800 500-20-54 — бронь номера
            </a>
          </div>
          <div class="icard rv">
            <h3>Записаться / уточнить</h3>
            <a class="reg-link" href="mailto:648501@mail.ru" style="margin-bottom:8px">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>648501@mail.ru
            </a>
            <a class="reg-link" href="tel:+79166574066" style="margin-bottom:8px">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15.5c0 1-.8 2.5-2 2.5C11.5 18 6 12.5 6 5c0-1.2 1.5-2 2.5-2 .4 0 .8.3 1 .7l1.5 3c.2.5.1 1-.3 1.3L9 9.3c.9 2 2.7 3.8 4.7 4.7l1.3-1.7c.3-.4.8-.5 1.3-.3l3 1.5c.4.2.7.6.7 1z"/></svg>
              8-916-657-40-66
            </a>
            <a class="reg-link" href="tel:+79883344020">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15.5c0 1-.8 2.5-2 2.5C11.5 18 6 12.5 6 5c0-1.2 1.5-2 2.5-2 .4 0 .8.3 1 .7l1.5 3c.2.5.1 1-.3 1.3L9 9.3c.9 2 2.7 3.8 4.7 4.7l1.3-1.7c.3-.4.8-.5 1.3-.3l3 1.5c.4.2.7.6.7 1z"/></svg>
              8-988-334-40-20
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REGISTER -->
  <section class="reg-section">
    <div class="wrap">
      <div class="reg-inner rv">
        <h2>Места ограничены — <span class="g">забронируйте участие</span></h2>
        <p>Оставьте заявку — мы свяжемся для подтверждения или пишите напрямую.</p>
        <div class="reg-btns">
          <button class="btn btn-primary" onclick="openModal()">Записаться →</button>
          <a class="btn btn-ghost" href="mailto:648501@mail.ru">📧 648501@mail.ru</a>
        </div>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="foot-in">
    <div class="foot-brand">Полный путь сложного неврологического пациента</div>
    <p>Практическая конференция для ветеринарных врачей. 27–29 ноября 2026, г. Краснодар.</p>
    <p style="margin-top:6px">648501@mail.ru · 8-916-657-40-66 · 8-988-334-40-20</p>
  </div>
  <div class="foot-bottom">© 2026 · VETOC.RU × сотниковым.vet · Все права защищены</div>
</footer>

<button class="top-btn" id="topBtn" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Наверх">↑</button>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="closeOut(event)">
  <div class="modal" id="modalBox">
    <button class="modal-close" onclick="closeModal()">✕</button>
    <div id="mForm">
      <div class="modal-eye">Конференция · 27–29 ноября</div>
      <h2>Записаться</h2>
      <p class="modal-sub">«Полный путь сложного неврологического пациента». Оставьте контакты — мы свяжемся.</p>
      <div class="fg"><label>Ваше имя *</label><input type="text" id="ef-name" placeholder="Как вас зовут?"></div>
      <div class="fg"><label>Телефон *</label><input type="tel" id="ef-phone" placeholder="+7 (___) ___-__-__" maxlength="18" inputmode="tel"></div>
      <div class="fg"><label>Email (необязательно)</label><input type="email" id="ef-email" placeholder="your@email.ru"></div>
      <div class="fg"><label>Комментарий</label><textarea id="ef-comment" placeholder="Клиника, город, вопросы…"></textarea></div>
      <div class="consent-wrap" onclick="toggleConsent()" id="cWrap">
        <div class="consent-row">
          <div class="consent-box" id="cBox"><svg width="13" height="13" viewBox="0 0 13 13"><polyline points="2,7 5,10 11,3" fill="none" stroke="var(--c0)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <input type="checkbox" id="ef-consent" style="display:none">
          <span class="consent-text">Я даю согласие на обработку персональных данных (ФЗ №152-ФЗ) для записи на конференцию.</span>
        </div>
        <div class="consent-err" id="cErr">⚠ Необходимо дать согласие</div>
      </div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;font-size:16px;padding:16px" onclick="submitForm()">Отправить заявку →</button>
    </div>
    <div class="form-success" id="mSuccess" style="display:none">
      <div style="font-size:48px">✅</div>
      <h3>Готово!</h3>
      <p>Выберите способ отправки — откроется чат или письмо с заполненными данными:</p>
      <div class="send-btns">
        <a id="sendWa" class="btn btn-primary" href="#" target="_blank">💬 Отправить в WhatsApp</a>
        <a id="sendMail" class="btn btn-ghost" href="#">📧 Отправить на почту</a>
      </div>
      <button class="btn btn-ghost" style="margin-top:12px;width:100%;justify-content:center" onclick="closeModal()">Закрыть</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ── LOADER ── */
(function(){
  var l=document.getElementById('ldr');
  var done=false;
  function hide(){if(done)return;done=true;l.classList.add('out')}
  var t=setTimeout(hide,3200);
  window.addEventListener('load',function(){setTimeout(hide,1800)});
})();

/* ── NAV SIDEBAR ── */
(function(){
  var b=document.getElementById('burgerBtn'),n=document.getElementById('qnav');
  if(!b)return;
  var ov=document.createElement('div');ov.className='nav-overlay';ov.id='nOv';document.body.appendChild(ov);
  function open(){b.classList.add('open');n.classList.add('open');ov.classList.add('open');document.body.style.overflow='hidden'}
  function close(){b.classList.remove('open');n.classList.remove('open');ov.classList.remove('open');document.body.style.overflow=''}
  b.addEventListener('click',function(){n.classList.contains('open')?close():open()});
  ov.addEventListener('click',close);
  n.querySelectorAll('a').forEach(function(a){a.addEventListener('click',close)});
})();

/* ── PARTICLES ── */
(function(){
  var c=document.getElementById('particles');
  if(!c)return;
  var ctx=c.getContext('2d');
  var W,H,pts=[];
  function resize(){W=c.width=c.offsetWidth;H=c.height=c.offsetHeight}
  resize();window.addEventListener('resize',resize);
  var colors=['rgba(0,180,230,.6)','rgba(64,212,255,.4)','rgba(240,165,0,.4)','rgba(255,255,255,.3)'];
  for(var i=0;i<60;i++)pts.push({x:Math.random()*2000,y:Math.random()*1000,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,r:Math.random()*2+.5,c:colors[Math.floor(Math.random()*colors.length)],o:Math.random()*.6+.2});
  function draw(){
    ctx.clearRect(0,0,W,H);
    pts.forEach(function(p){
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=p.c;ctx.globalAlpha=p.o;ctx.fill();
    });
    ctx.globalAlpha=1;
    requestAnimationFrame(draw);
  }
  draw();
})();

/* ── 3D TILT on cards ── */
(function(){
  if(window.matchMedia('(hover:none)').matches)return;
  document.querySelectorAll('.spk-card,.acard').forEach(function(card){
    var raf=null;
    card.addEventListener('mousemove',function(e){
      var r=card.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width-.5,py=(e.clientY-r.top)/r.height-.5;
      if(raf)cancelAnimationFrame(raf);
      raf=requestAnimationFrame(function(){
        var d=card.classList.contains('spk-card')?14:10;
        card.style.transform='perspective(800px) rotateX('+(-py*d).toFixed(2)+'deg) rotateY('+(px*d).toFixed(2)+'deg) translateY(-6px) scale(1.02)';
      });
    });
    card.addEventListener('mouseleave',function(){if(raf)cancelAnimationFrame(raf);card.style.transform='';});
  });
})();

/* ── SCROLL REVEAL ── */
(function(){
  var els=document.querySelectorAll('.rv,.rv-l');
  if(!('IntersectionObserver'in window)){els.forEach(function(e){e.classList.add('in')});return}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.05,rootMargin:'0px 0px -5% 0px'});
  els.forEach(function(e){io.observe(e)});
})();

/* ── TOP BUTTON ── */
(function(){
  var btn=document.getElementById('topBtn');
  window.addEventListener('scroll',function(){btn.classList.toggle('vis',window.scrollY>400)},{passive:true});
})();

/* ── HERO PARALLAX ── */
(function(){
  var img=document.querySelector('.hero-bg img');
  if(!img||window.matchMedia('(hover:none)').matches)return;
  window.addEventListener('scroll',function(){
    var s=window.pageYOffset;
    if(s<window.innerHeight*1.5)img.style.transform='scale(1.08) translateY('+(s*.12)+'px)';
  },{passive:true});
})();

/* ── MODAL ── */
function openModal(){document.getElementById('modalOverlay').classList.add('open');document.getElementById('mForm').style.display='block';document.getElementById('mSuccess').style.display='none';document.body.style.overflow='hidden'}
function closeModal(){document.getElementById('modalOverlay').classList.remove('open');document.body.style.overflow=''}
function closeOut(e){if(e.target===document.getElementById('modalOverlay'))closeModal()}
function toggleConsent(){var cb=document.getElementById('ef-consent'),box=document.getElementById('cBox');cb.checked=!cb.checked;box.classList.toggle('on',cb.checked);document.getElementById('cErr').classList.remove('show')}
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(window._tt);window._tt=setTimeout(function(){t.classList.remove('show')},3000)}
function submitForm(){
  var name=(document.getElementById('ef-name').value||'').trim();
  var phone=document.getElementById('ef-phone').value.trim();
  var email=(document.getElementById('ef-email').value||'').trim();
  var comment=document.getElementById('ef-comment').value.trim();
  var consent=document.getElementById('ef-consent');
  if(!name){toast('Введите имя');document.getElementById('ef-name').focus();return}
  if(!phone||phone.replace(/\D/g,'').length<10){toast('Введите телефон');document.getElementById('ef-phone').focus();return}
  if(!consent.checked){document.getElementById('cErr').classList.add('show');return}
  var subj='Заявка на конференцию 27-29 ноября — '+name;
  var text='Заявка на конференцию «Полный путь сложного неврологического пациента», 27–29 ноября 2026, Краснодар.\nИмя: '+name+'\nТелефон: '+phone+(email?'\nEmail: '+email:'')+(comment?'\nКомментарий: '+comment:'');
  document.getElementById('sendWa').href='https://wa.me/79166574066?text='+encodeURIComponent(text);
  document.getElementById('sendMail').href='mailto:648501@mail.ru?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(text);
  document.getElementById('mForm').style.display='none';
  document.getElementById('mSuccess').style.display='block';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal()});

/* ── SHARE ── */
function share(n){var url=window.location.href,title='Конференция «Полный путь неврологического пациента» — 27–29 ноября, Краснодар';if(n==='vk')window.open('https://vk.com/share.php?url='+encodeURIComponent(url)+'&title='+encodeURIComponent(title),'_blank','noopener,width=600,height=500');else if(n==='tg')window.open('https://t.me/share/url?url='+encodeURIComponent(url)+'&text='+encodeURIComponent(title),'_blank','noopener,width=600,height=500');else navigator.clipboard&&navigator.clipboard.writeText(url).then(function(){toast('Ссылка скопирована!')});}
</script>
</body>
</html>
